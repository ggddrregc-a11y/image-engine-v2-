# ─── Server ──────────────────────────────────────────────────────────
PORT=5000

# ─── Supabase ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Service role key (server-side only — never expose in frontend)
SUPABASE_SERVICE_KEY=eyJ...

# ─── Facebook Graph API ───────────────────────────────────────────────
# Page Access Token (long-lived) من Meta Developer Console
FACEBOOK_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# رقم الصفحة أو اسمها (مثال: 123456789 أو mypagename)
FACEBOOK_PAGE_ID=123456789

# ─── ComfyUI (اختياري) ───────────────────────────────────────────────
COMFYUI_BASE_URL=http://localhost:8188

# ─── Image Editor API (اختياري) ──────────────────────────────────────
IMAGE_EDITOR_API_URL=
PUBLIC_URL=
