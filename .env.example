# Example environment variables for deployment
# Copy this file to .env.local (development) or set these in your hosting provider.

# ComfyUI base URL (CloudSpaces or http://localhost:8188)
COMFYUI_BASE_URL=

# Supabase (public/client) - required by the app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side keys) - only set on server, never expose in client
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: other runtime flags
# NODE_ENV=production
